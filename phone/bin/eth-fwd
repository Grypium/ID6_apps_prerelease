#!/data/data/com.termux/files/usr/bin/python3
"""Relay localhost ports to hosts on the Ethernet (eth0) network.
Android routes app traffic over Wi-Fi/mobile, so 169.254.x.x (car ENET) is unreachable
directly; each outgoing socket here is bound to the Ethernet network via android_setsocknetwork.
Usage: eth-fwd LPORT:HOST:RPORT [...]   e.g. eth-fwd 2222:HEAD_UNIT_IP:22 6801:GATEWAY_IP:6801"""
import ctypes, socket, subprocess, sys, threading, re
def eth_handle():
    out = subprocess.run(["adb","-s","localhost:5555","shell","dumpsys connectivity"],capture_output=True,text=True).stdout
    for line in out.splitlines():
        if "ni{Ethernet CONNECTED" in line:
            return int(re.search(r"handle\{(\d+)\}", line).group(1))
    sys.exit("Ethernet network not connected")
H = eth_handle()
lib = ctypes.CDLL("libandroid.so", use_errno=True)
lib.android_setsocknetwork.argtypes = [ctypes.c_uint64, ctypes.c_int]
def pump(a, b):
    try:
        while (d := a.recv(65536)): b.sendall(d)
    except OSError: pass
    finally:
        for s in (a, b):
            try: s.shutdown(socket.SHUT_RDWR)
            except OSError: pass
def serve(lport, host, rport):
    ls = socket.socket(); ls.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    ls.bind(("127.0.0.1", lport)); ls.listen(8)
    print(f"127.0.0.1:{lport} -> {host}:{rport} (eth handle {H})", flush=True)
    while True:
        c, _ = ls.accept()
        r = socket.socket()
        if lib.android_setsocknetwork(H, r.fileno()) != 0:
            print("bind to eth failed", ctypes.get_errno(), flush=True); c.close(); continue
        try: r.connect((host, rport))
        except OSError as e:
            print(f"{host}:{rport} {e}", flush=True); c.close(); r.close(); continue
        for x in (c, r): x.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        threading.Thread(target=pump, args=(c, r), daemon=True).start()
        threading.Thread(target=pump, args=(r, c), daemon=True).start()
for spec in sys.argv[1:]:
    l, h, p = spec.split(":")
    threading.Thread(target=serve, args=(int(l), h, int(p)), daemon=True).start()
threading.Event().wait()
