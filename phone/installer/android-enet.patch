diff --git a/source/netbind_android.go b/source/netbind_android.go
new file mode 100644
index 0000000..15faa8a
--- /dev/null
+++ b/source/netbind_android.go
@@ -0,0 +1,44 @@
+//go:build android
+
+package main
+
+/*
+#cgo LDFLAGS: -landroid
+#include <android/multinetwork.h>
+#include <errno.h>
+static int bind_net(unsigned long long h, int fd) {
+	if (android_setsocknetwork((net_handle_t)h, fd) != 0) return errno ? errno : -1;
+	return 0;
+}
+*/
+import "C"
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+	"syscall"
+)
+
+// Android routes app traffic over Wi-Fi/mobile even when Ethernet is up, so
+// 169.254.x.x (car ENET) is unreachable unless each socket is bound to the
+// Ethernet network. NBT_NET_HANDLE is that network's handle (from
+// `dumpsys connectivity`, set by the nbt-installer-android wrapper).
+func bindENET(c syscall.RawConn) error {
+	h := os.Getenv("NBT_NET_HANDLE")
+	if h == "" {
+		return nil
+	}
+	v, err := strconv.ParseUint(h, 10, 64)
+	if err != nil {
+		return fmt.Errorf("bad NBT_NET_HANDLE: %w", err)
+	}
+	var rc C.int
+	if err := c.Control(func(fd uintptr) { rc = C.bind_net(C.ulonglong(v), C.int(fd)) }); err != nil {
+		return err
+	}
+	if rc != 0 {
+		return fmt.Errorf("binding socket to Ethernet network failed (errno %d)", int(rc))
+	}
+	return nil
+}
